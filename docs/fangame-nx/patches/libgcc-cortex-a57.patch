--- a/libgcc/config/aarch64/value-unwind.h
+++ b/libgcc/config/aarch64/value-unwind.h
@@ -33,10 +33,15 @@
 static inline int
 aarch64_vg (void)
 {
+#ifdef FNX_CORTEX_A57_ONLY
+  /* Cortex-A57 has no SVE VG register.  Fail if unsupported CFI asks for it.  */
+  __builtin_trap ();
+#else
   register int vg asm ("x0");
   /* CNTD X0.  */
   asm (".inst 0x04e0e3e0" : "=r" (vg));
   return vg;
+#endif
 }
 
